@model WebTruyen.Models.Book
@{
    ViewData["Title"] = "Sửa sách";
    Layout = "_AdminLayout";
}

<h2>Sửa sách</h2>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="BookId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label>Tên sách</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Tác giả</label>
        <input asp-for="Author" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Danh mục</label>
        <select asp-for="CategoryId" class="form-select">
            @foreach (var cate in (List<WebTruyen.Models.Category>)ViewBag.Categories)
            {
                <option value="@cate.CategoryId">@cate.CategoryName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Mô tả</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label>Giá</label>
        <input asp-for="Price" type="number" step="1000" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Tồn kho</label>
        <input asp-for="Stock" type="number" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Link ảnh</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
</form>