@model List<WebTruyen.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
    Layout = "_AdminLayout";
}

<h2>Quản lý sách</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Thêm sách</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên sách</th>
            <th>Tác giả</th>
            <th>Danh mục</th>
            <th>Giá</th>
            <th>Tồn kho</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Category?.CategoryName</td>
                <td>@book.Price.ToString("N0") đ</td>
                <td>@book.Stock</td>
                <td>
                    @if (book.IsActive == true)
                    {
                        <span class="badge bg-success">Đang bán</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã ẩn</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-warning">Sửa</a>
                    <form method="post" asp-action="ToggleActive" asp-route-id="@book.BookId" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-secondary">
                            @(book.IsActive == true ? "Ẩn" : "Hiện")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>