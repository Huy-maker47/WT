@model List<WebTruyen.Models.Book>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero">
    <h1>Mỗi trang sách,<br />một cuộc phiêu lưu.</h1>
    <p>Kho truyện đa dạng thể loại — từ tiểu thuyết kinh điển đến ngôn tình, trinh thám. Đặt hàng dễ dàng, giao tận nơi.</p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-success">Khám phá ngay</a>

    <div class="hero-stack">
        <div class="stack-card"></div>
        <div class="stack-card"></div>
        <div class="stack-card"></div>
    </div>
</div>
<div id="homeBanner"
     class="carousel slide home-banner"
     data-bs-ride="carousel"
     data-bs-interval="4000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="0" class="active" aria-current="true"></button>
        <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="https://bookbuy.vn/Res/Images/Album/7c250455-592b-4ef7-885b-f36b84ac0516.jpg?w=920&h=420&mode=crop"
                 class="d-block w-100"
                 alt="Banner 1" />
        </div>

        <div class="carousel-item">
            <img src="https://bookbuy.vn/Res/Images/Album/efdd9c2f-ed8f-4373-8514-f25510165c57.jpg?w=920&h=420&mode=crop'
class=" d-block w-100"
                 alt="Banner 2" />
        </div>

        <div class="carousel-item">
            <img src="https://bookbuy.vn/Res/Images/Album/6bfae9a9-1025-43a0-bdf6-32918fa9dbfe.png?w=920&h=420&mode=crop"
                 class="d-block w-100"
                 alt="Banner 3" />
        </div>

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#homeBanner"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#homeBanner"
            data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>

<div class="section-heading">
    <h2>Sách mới về</h2>
    <a asp-controller="Books" asp-action="Index" class="text-decoration-none">Xem tất cả &rarr;</a>
</div>

<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="book-card">
                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">
                    <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? "/images/no-image.png" : book.ImageUrl)" alt="@book.Title" />
                </a>
                <div class="card-body">
                    <div class="card-title">@book.Title</div>
                    <div class="card-author">@book.Author</div>
                    <div class="card-price">@book.Price.ToString("N0") đ</div>
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId"
                       class="btn btn-outline-primary btn-sm mt-2 w-100">Xem chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <p>Chưa có sách nào để hiển thị.</p>
}