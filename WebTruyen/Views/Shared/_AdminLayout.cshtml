<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="d-flex">
        <nav class="bg-dark text-white p-3" style="width:220px;min-height:100vh;">
            <h5>Admin Panel</h5>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link text-white" asp-controller="AdminBooks" asp-action="Index">Quản lý sách</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="AdminCategories" asp-action="Index">Danh mục</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="AdminOrders" asp-action="Index">Đơn hàng</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Về trang chủ</a></li>
            </ul>
        </nav>
        <div class="p-4 flex-grow-1">
            @RenderBody()
        </div>
    </div>
</body>
</html>