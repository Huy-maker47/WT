@model List<WebTruyen.Models.Book>
@{
    ViewData["Title"] = "Danh sách sách";
}

<h2>Danh sách sách</h2>

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả danh mục --</option>
            @foreach (var cate in (List<WebTruyen.Models.Category>)ViewBag.Categories)
            {
                <option value="@cate.CategoryId" selected="@(ViewBag.CategoryId == cate.CategoryId)">
                    @cate.CategoryName
                </option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên/tác giả..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Tìm</button>
    </div>
</form>

<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? "/images/no-image.png" : book.ImageUrl)"
                     class="card-img-top" style="height:250px;object-fit:cover;" />
                <div class="card-body">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="card-text text-muted">@book.Author</p>
                    <p class="card-text fw-bold text-danger">@book.Price.ToString("N0") đ</p>
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId"
                       class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p>Không tìm thấy sách nào.</p>
}