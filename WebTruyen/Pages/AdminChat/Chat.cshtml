@page "{userId:int}"
@model WebTruyen.Pages.AdminChat.ChatModel

@{
    ViewData["Title"] = "Chat với " + Model.CustomerName;
    Layout = "_AdminLayout";
}

<div class="admin-support-chat-page">

    <header class="admin-support-page-header">

        <div>
            <a asp-page="Index"
               class="admin-support-back">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5"></path>
                    <path d="m12 19-7-7 7-7"></path>
                </svg>

                Quay lại danh sách
            </a>

            <span class="admin-support-eyebrow">
                HỖ TRỢ KHÁCH HÀNG
            </span>

            <h1>Chat với @Model.CustomerName</h1>
        </div>

        <div id="adminConnectionStatus"
             class="admin-support-connection connecting">

            <span></span>
            <strong>Đang kết nối</strong>

        </div>

    </header>

    <section class="admin-support-chat-card">

        <!-- Header hội thoại -->
        <div class="admin-support-chat-header">

            <div class="admin-support-customer">

                <span class="admin-support-customer-avatar">
                    @(string.IsNullOrWhiteSpace(Model.CustomerName)
                                        ? "K"
                                        : Model.CustomerName.Trim()
                                        .Substring(0, 1)
                                        .ToUpper())

                    <i></i>
                </span>

                <div>
                    <h2>@Model.CustomerName</h2>
                    <p>Khách hàng METruyen</p>
                </div>

            </div>

            <span class="admin-support-label">
                Hội thoại hỗ trợ
            </span>

        </div>

        <!-- Nội dung -->
        <div id="adminChatBox"
             class="admin-support-messages"
             aria-live="polite">

            @if (!Model.Messages.Any())
            {
                <div class="admin-support-empty"
                     id="adminChatEmpty">

                    <span>
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M21 12a8 8 0 0 1-8 8H7l-4 2 1.5-4A8 8 0 1 1 21 12Z"></path>
                        </svg>
                    </span>

                    <h3>Chưa có tin nhắn</h3>

                    <p>
                        Hãy bắt đầu cuộc trò chuyện với khách hàng.
                    </p>

                </div>
            }

            @foreach (var message in Model.Messages)
            {
                var isMine =
                message.SenderId == Model.MyUserId;

                <div class="admin-support-message
                                @(isMine ? "mine" : "customer")">

                    @if (!isMine)
                    {
                        <span class="admin-support-message-avatar">
                            @(string.IsNullOrWhiteSpace(Model.CustomerName)
                                                ? "K"
                                                : Model.CustomerName.Trim()
                                                .Substring(0, 1)
                                                .ToUpper())
                </span>
                                }

                    <div class="admin-support-message-content">

                        <span class="admin-support-sender">
                            @(isMine ? "Bạn" : Model.CustomerName)
                        </span>

                        <div class="admin-support-bubble">
                            @message.Content
                        </div>

                        <time>
                            @message.SentDate?.ToString("HH:mm")
                        </time>

                    </div>

                </div>
            }

        </div>

        <!-- Form gửi -->
        <form id="adminChatForm"
              class="admin-support-composer"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <div class="admin-support-input">

                <input type="text"
                       id="adminMessageInput"
                       placeholder="Nhập nội dung trả lời..."
                       maxlength="1000"
                       autocomplete="off" />

                <span>Nhấn Enter để gửi</span>

            </div>

            <button type="submit"
                    id="adminSendButton"
                    class="admin-support-send">

                <span>Gửi</span>

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m22 2-7 20-4-9-9-4Z"></path>
                    <path d="M22 2 11 13"></path>
                </svg>

            </button>

        </form>

    </section>

</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js">
    </script>

    <script>
        const customerId =
            Number("@Model.CustomerId");

        const customerName =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.CustomerName
                )
                );

    const chatBox =
        document.getElementById(
            "adminChatBox"
        );

    const chatForm =
        document.getElementById(
            "adminChatForm"
        );

    const messageInput =
        document.getElementById(
            "adminMessageInput"
        );

    const sendButton =
        document.getElementById(
            "adminSendButton"
        );

    const connectionStatus =
        document.getElementById(
            "adminConnectionStatus"
        );

    let connection = null;

    chatForm.addEventListener(
        "submit",
        async function (event) {
            event.preventDefault();

            const content =
                messageInput.value.trim();

            if (!content) {
                messageInput.focus();
                return;
            }

            const tokenInput =
                chatForm.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            if (!tokenInput) {
                showAdminChatError(
                    "Không tìm thấy mã bảo mật."
                );

                return;
            }

            setAdminSending(true);

            try {
                const response = await fetch(
                    window.location.pathname +
                    "?handler=SendMessage",
                    {
                        method: "POST",
                        credentials: "same-origin",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "RequestVerificationToken":
                                tokenInput.value
                        },

                        body: JSON.stringify({
                            receiverId: customerId,
                            content: content
                        })
                    }
                );

                if (!response.ok) {
                    const errorText =
                        await response.text();

                    console.error(
                        "Lỗi lưu tin nhắn:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "Không thể lưu tin nhắn."
                    );
                }

                appendAdminMessage(
                    content,
                    true
                );

                messageInput.value = "";
                messageInput.focus();

                if (
                    connection &&
                    connection.state ===
                    signalR
                        .HubConnectionState
                        .Connected
                ) {
                    try {
                        await connection.invoke(
                            "SendMessage",
                            customerId,
                            content
                        );
                    }
                    catch (signalRError) {
                        console.warn(
                            "Tin đã lưu nhưng realtime lỗi:",
                            signalRError
                        );
                    }
                }
            }
            catch (error) {
                console.error(error);

                showAdminChatError(
                    "Không gửi được tin nhắn. Vui lòng thử lại."
                );
            }
            finally {
                setAdminSending(false);
            }
        }
    );

    messageInput.addEventListener(
        "keydown",
        function (event) {
            if (
                event.key === "Enter" &&
                !event.isComposing
            ) {
                event.preventDefault();
                chatForm.requestSubmit();
            }
        }
    );

    async function startAdminSignalR() {
        if (typeof signalR === "undefined") {
            updateAdminConnection(
                "disconnected"
            );

            return;
        }

        connection =
            new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

        connection.on(
            "ReceiveMessage",
            function (content) {
                appendAdminMessage(
                    content,
                    false
                );
            }
        );

        connection.onreconnecting(
            function () {
                updateAdminConnection(
                    "connecting"
                );
            }
        );

        connection.onreconnected(
            function () {
                updateAdminConnection(
                    "connected"
                );
            }
        );

        connection.onclose(
            function () {
                updateAdminConnection(
                    "disconnected"
                );
            }
        );

        try {
            await connection.start();

            updateAdminConnection(
                "connected"
            );
        }
        catch (error) {
            console.error(
                "SignalR chưa kết nối:",
                error
            );

            updateAdminConnection(
                "disconnected"
            );

            setTimeout(
                startAdminSignalR,
                3000
            );
        }
    }

    function appendAdminMessage(
        content,
        isMine
    ) {
        const emptyState =
            document.getElementById(
                "adminChatEmpty"
            );

        if (emptyState) {
            emptyState.remove();
        }

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "admin-support-message " +
            (isMine ? "mine" : "customer");

        if (!isMine) {
            const avatar =
                document.createElement("span");

            avatar.className =
                "admin-support-message-avatar";

            avatar.textContent =
                customerName
                    ? customerName.charAt(0)
                        .toUpperCase()
                    : "K";

            wrapper.appendChild(avatar);
        }

        const messageContent =
            document.createElement("div");

        messageContent.className =
            "admin-support-message-content";

        const sender =
            document.createElement("span");

        sender.className =
            "admin-support-sender";

        sender.textContent =
            isMine
                ? "Bạn"
                : customerName;

        const bubble =
            document.createElement("div");

        bubble.className =
            "admin-support-bubble";

        bubble.textContent = content;

        const time =
            document.createElement("time");

        time.textContent =
            new Date().toLocaleTimeString(
                "vi-VN",
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );

        messageContent.appendChild(sender);
        messageContent.appendChild(bubble);
        messageContent.appendChild(time);

        wrapper.appendChild(messageContent);
        chatBox.appendChild(wrapper);

        scrollAdminChat();
    }

    function setAdminSending(isSending) {
        sendButton.disabled = isSending;

        sendButton.querySelector(
            "span"
        ).textContent =
            isSending
                ? "Đang gửi"
                : "Gửi";
    }

    function showAdminChatError(content) {
        const error =
            document.createElement("div");

        error.className =
            "admin-support-error";

        error.textContent = content;

        chatBox.appendChild(error);
        scrollAdminChat();

        setTimeout(
            function () {
                error.remove();
            },
            3500
        );
    }

    function updateAdminConnection(status) {
        connectionStatus.className =
            "admin-support-connection " +
            status;

        const text =
            connectionStatus.querySelector(
                "strong"
            );

        if (status === "connected") {
            text.textContent =
                "Đã kết nối";
        }
        else if (status === "disconnected") {
            text.textContent =
                "Mất kết nối";
        }
        else {
            text.textContent =
                "Đang kết nối";
        }
    }

    function scrollAdminChat() {
        chatBox.scrollTop =
            chatBox.scrollHeight;
    }

    scrollAdminChat();
    startAdminSignalR();
</script>
}