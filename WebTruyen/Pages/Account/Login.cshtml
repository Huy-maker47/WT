@page
@model WebTruyen.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <div class="auth-card">

        <!-- Phần giới thiệu bên trái -->
        <div class="auth-visual">
            <div class="auth-logo">M</div>

            <h1>Chào mừng trở lại</h1>

            <p>
                Đăng nhập để tiếp tục mua sách, quản lý đơn hàng
                và lưu lại những cuốn sách yêu thích.
            </p>

            <div class="auth-decoration">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <!-- Form đăng nhập -->
        <div class="auth-form-panel">

            <div class="auth-heading">
                <span class="auth-label">METruyen</span>

                <h2>Đăng nhập</h2>

                <p>Nhập thông tin tài khoản của bạn.</p>
            </div>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger auth-validation">
                </div>

                <div class="mb-3">
                    <label asp-for="Username"
                           class="form-label">
                        Tên đăng nhập
                    </label>

                    <input asp-for="Username"
                           class="form-control auth-input"
                           placeholder="Nhập tên đăng nhập"
                           autocomplete="username"
                           autofocus />

                    <span asp-validation-for="Username"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-2">
                    <label asp-for="Password"
                           class="form-label">
                        Mật khẩu
                    </label>

                    <div class="auth-password-wrap">
                        <input asp-for="Password"
                               id="loginPassword"
                               type="password"
                               class="form-control auth-input"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password" />

                        <button type="button"
                                id="togglePassword"
                                class="auth-password-toggle">
                            Hiện
                        </button>
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>
                </div>

                <button type="submit"
                        class="btn auth-submit">
                    Đăng nhập
                </button>

            </form>

            <div class="auth-register">
                Chưa có tài khoản?

                <a asp-page="/Account/Register">
                    Đăng ký ngay
                </a>
            </div>

            <div class="auth-back">
                <a asp-page="/Index">
                    ← Quay lại trang chủ
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordInput =
            document.getElementById("loginPassword");

        const toggleButton =
            document.getElementById("togglePassword");

        toggleButton.addEventListener("click", function () {
            const isHidden =
                passwordInput.type === "password";

            passwordInput.type =
                isHidden ? "text" : "password";

            toggleButton.textContent =
                isHidden ? "Ẩn" : "Hiện";
        });
    </script>
}