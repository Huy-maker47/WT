@page "{id:int}"
@model WebTruyen.Pages.AdminOrders.DetailsModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_AdminLayout";

    var orderStatus = Model.OrderData.Status ?? "Chưa cập nhật";
    var paymentStatus = Model.OrderData.PaymentStatus ?? "Chưa cập nhật";

    var statusClass = orderStatus switch
    {
        "Chờ xác nhận" => "waiting",
        "Đang giao" => "shipping",
        "Hoàn thành" => "completed",
        "Đã hủy" => "cancelled",
        _ => "default"
    };

    var paymentClass = paymentStatus switch
    {
        "Đã thanh toán" => "paid",
        "Chờ thanh toán" => "waiting",
        "Chờ xác nhận thanh toán" => "waiting",
        "Chưa nhận được tiền" => "failed",
        _ => "unpaid"
    };
}

<div class="order-detail-page">

    <!-- Tiêu đề -->
    <header class="order-detail-header">

        <div>
            <a asp-page="Index"
               class="order-detail-back">
                ← Quay lại danh sách
            </a>

            <h1>Đơn hàng #@Model.OrderData.OrderId</h1>

            <p>
                Đặt lúc
                @Model.OrderData.OrderDate?.ToString("HH:mm, dd/MM/yyyy")
            </p>
        </div>

        <span class="order-detail-status @statusClass">
            @orderStatus
        </span>

    </header>

    @if (TempData["Success"] != null)
    {
        <div class="order-detail-alert success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="order-detail-alert error">
            @TempData["Error"]
        </div>
    }

    <div class="order-detail-top">

        <!-- Thông tin nhận hàng -->
        <section class="order-detail-card">

            <header class="order-detail-card-header">
                <h2>Thông tin nhận hàng</h2>
                <span>Thông tin khách cung cấp</span>
            </header>

            <div class="order-detail-information">

                <div class="order-detail-info-row">
                    <span>Người nhận</span>
                    <strong>@Model.OrderData.ReceiverName</strong>
                </div>

                <div class="order-detail-info-row">
                    <span>Số điện thoại</span>
                    <strong>@Model.OrderData.ReceiverPhone</strong>
                </div>

                <div class="order-detail-info-row full">
                    <span>Địa chỉ</span>
                    <strong>@Model.OrderData.ShippingAddress</strong>
                </div>

                <div class="order-detail-info-row full">
                    <span>Ghi chú</span>

                    <strong class="order-detail-note">
                        @(string.IsNullOrWhiteSpace(Model.OrderData.Note)
                                                ? "Không có ghi chú"
                                                : Model.OrderData.Note)
                    </strong>
                </div>

            </div>

        </section>

        <!-- Cập nhật đơn -->
        <section class="order-detail-card">

            <header class="order-detail-card-header">
                <h2>Cập nhật đơn hàng</h2>
                <span>Phương thức: @Model.OrderData.PaymentMethod</span>
            </header>

            <div class="order-detail-payment-current">

                <span>Thanh toán hiện tại</span>

                <strong class="@paymentClass">
                    @paymentStatus
                </strong>

            </div>

            <!-- Trạng thái thanh toán -->
            <form method="post"
                  asp-page-handler="UpdatePaymentStatus"
                  class="order-detail-update-form">

                <input type="hidden"
                       name="orderId"
                       value="@Model.OrderData.OrderId" />

                <label for="paymentStatus">
                    Trạng thái thanh toán
                </label>

                <div class="order-detail-update-control">

                    <select id="paymentStatus"
                            name="paymentStatus">

                        <option value="Chưa thanh toán"
                                selected="@(paymentStatus == "Chưa thanh toán" ? "selected" : null)">
                            Chưa thanh toán
                        </option>

                        <option value="Chờ thanh toán"
                                selected="@(paymentStatus == "Chờ thanh toán" ? "selected" : null)">
                            Chờ thanh toán
                        </option>

                        <option value="Chờ xác nhận thanh toán"
                                selected="@(paymentStatus == "Chờ xác nhận thanh toán" ? "selected" : null)">
                            Chờ xác nhận thanh toán
                        </option>

                        <option value="Chưa nhận được tiền"
                                selected="@(paymentStatus == "Chưa nhận được tiền" ? "selected" : null)">
                            Chưa nhận được tiền
                        </option>

                        <option value="Đã thanh toán"
                                selected="@(paymentStatus == "Đã thanh toán" ? "selected" : null)">
                            Đã thanh toán
                        </option>

                    </select>

                    <button type="submit">
                        Lưu
                    </button>

                </div>

            </form>

            <!-- Trạng thái đơn -->
            <form method="post"
                  asp-page-handler="UpdateStatus"
                  class="order-detail-update-form">

                <input type="hidden"
                       name="orderId"
                       value="@Model.OrderData.OrderId" />

                <label for="orderStatus">
                    Trạng thái đơn hàng
                </label>

                <div class="order-detail-update-control">

                    <select id="orderStatus"
                            name="status">

                        <option value="Chờ xác nhận"
                                selected="@(orderStatus == "Chờ xác nhận" ? "selected" : null)">
                            Chờ xác nhận
                        </option>

                        <option value="Đang giao"
                                selected="@(orderStatus == "Đang giao" ? "selected" : null)">
                            Đang giao
                        </option>

                        <option value="Hoàn thành"
                                selected="@(orderStatus == "Hoàn thành" ? "selected" : null)">
                            Hoàn thành
                        </option>

                        <option value="Đã hủy"
                                selected="@(orderStatus == "Đã hủy" ? "selected" : null)">
                            Đã hủy
                        </option>

                    </select>

                    <button type="submit">
                        Lưu
                    </button>

                </div>

            </form>

        </section>

    </div>

    <!-- Danh sách sản phẩm -->
    <section class="order-detail-card order-detail-products">

        <header class="order-detail-card-header">
            <h2>Sản phẩm trong đơn</h2>

            <span>
                @Model.OrderData.OrderDetails.Sum(item => item.Quantity)
                sản phẩm
            </span>
        </header>

        <div class="order-detail-product-list">

            @foreach (var item in Model.OrderData.OrderDetails)
            {
                var lineTotal = item.UnitPrice * item.Quantity;

                <article class="order-detail-product">

                    <img src="@(string.IsNullOrWhiteSpace(item.Book.ImageUrl)
                                                         ? "/images/no-image.png"
                                                         : item.Book.ImageUrl)"
                     alt="@item.Book.Title" />

                    <div class="order-detail-product-name">

                        <strong>@item.Book.Title</strong>

                        <span>
                            @item.UnitPrice.ToString("N0") đ
                            × @item.Quantity
                        </span>

                    </div>

                    <strong class="order-detail-product-total">
                        @lineTotal.ToString("N0") đ
                    </strong>

                </article>
                        }

        </div>

        <footer class="order-detail-total">

            <span>Tổng thanh toán</span>

            <strong>
                @Model.OrderData.TotalAmount.ToString("N0") đ
            </strong>

        </footer>

    </section>

</div>