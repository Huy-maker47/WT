@page "{id:int}"
@model WebTruyen.Pages.AdminOrders.DetailsModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_AdminLayout";
}

<h2>Đơn hàng #@Model.OrderData.OrderId</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <p><strong>Người nhận:</strong> @Model.OrderData.ReceiverName</p>
        <p><strong>SĐT:</strong> @Model.OrderData.ReceiverPhone</p>
        <p><strong>Địa chỉ:</strong> @Model.OrderData.ShippingAddress</p>
        <p><strong>Ghi chú:</strong> @Model.OrderData.Note</p>
    </div>
    <div class="col-md-6">
        <p><strong>Ngày đặt:</strong> @Model.OrderData.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
        <p>
            <strong>Phương thức thanh toán:</strong>

            @if (Model.OrderData.PaymentMethod == "Chuyển khoản")
            {
                <span class="badge bg-primary">
                    Chuyển khoản ngân hàng
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    COD
                </span>
            }
        </p>

        @if (Model.OrderData.PaymentMethod == "Chuyển khoản")
        {
            <div class="card border-primary mb-3">
                <div class="card-header bg-primary text-white">
                    Xác nhận chuyển khoản
                </div>

                <div class="card-body">

                    <p class="mb-2">
                        <strong>Mã đơn:</strong>
                        #@Model.OrderData.OrderId
                    </p>

                    <p class="mb-2">
                        <strong>Nội dung chuyển khoản:</strong>

                        <code>
                            METRUYEN ORD@(Model.OrderData.OrderId)
                        </code>
                    </p>

                    <p class="mb-3">
                        <strong>Số tiền cần nhận:</strong>

                        <span class="text-danger fw-bold">
                            @Model.OrderData.TotalAmount.ToString("N0") đ
                        </span>
                    </p>

                    <p>
                        <strong>Trạng thái thanh toán:</strong>

                        @if (Model.OrderData.PaymentStatus == "Đã thanh toán")
                        {
                            <span class="badge bg-success">
                                Đã thanh toán
                            </span>
                        }
                        else if (
                        Model.OrderData.PaymentStatus ==
                        "Chờ xác nhận thanh toán")
                        {
                            <span class="badge bg-warning text-dark">
                                Chờ Admin xác nhận
                            </span>
                        }
                        else if (
                        Model.OrderData.PaymentStatus ==
                        "Chưa nhận được tiền")
                        {
                            <span class="badge bg-danger">
                                Chưa nhận được tiền
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.OrderData.PaymentStatus
                            </span>
                        }
                    </p>

                    @if (
                                    Model.OrderData.PaymentStatus ==
                                    "Chờ xác nhận thanh toán")
                    {
                        <div class="d-flex flex-wrap gap-2">

                            <form method="post"
                                  asp-page-handler="ConfirmBankTransfer"
                                  onsubmit="return confirm('Xác nhận đã nhận đủ tiền cho đơn hàng này?');">

                                <input type="hidden"
                                       name="orderId"
                                       value="@Model.OrderData.OrderId" />

                                <button type="submit"
                                        class="btn btn-success">
                                    Xác nhận đã nhận tiền
                                </button>
                            </form>

                            <form method="post"
                                  asp-page-handler="RejectBankTransfer"
                                  onsubmit="return confirm('Xác nhận chưa nhận được tiền?');">

                                <input type="hidden"
                                       name="orderId"
                                       value="@Model.OrderData.OrderId" />

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    Chưa nhận được tiền
                                </button>
                            </form>

                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- COD vẫn cập nhật thủ công như cũ -->
            <form method="post"
                  asp-page-handler="UpdatePaymentStatus"
                  class="d-flex gap-2 mb-3">

                <input type="hidden"
                       name="orderId"
                       value="@Model.OrderData.OrderId" />

                <select name="paymentStatus"
                        class="form-select">

                    @if (
                                    Model.OrderData.PaymentStatus ==
                                    "Chưa thanh toán")
                    {
                        <option value="Chưa thanh toán" selected>
                            Chưa thanh toán
                        </option>
                    }
                    else
                    {
                        <option value="Chưa thanh toán">
                            Chưa thanh toán
                        </option>
                    }

                    @if (
                                    Model.OrderData.PaymentStatus ==
                                    "Đã thanh toán")
                    {
                        <option value="Đã thanh toán" selected>
                            Đã thanh toán
                        </option>
                    }
                    else
                    {
                        <option value="Đã thanh toán">
                            Đã thanh toán
                        </option>
                    }

                </select>

                <button type="submit"
                        class="btn btn-secondary">
                    Cập nhật
                </button>
            </form>
        }

        <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-2">
            <input type="hidden" name="orderId" value="@Model.OrderData.OrderId" />
            <select name="status" class="form-select">
                <option value="Chờ xác nhận" selected="@(Model.OrderData.Status == "Chờ xác nhận")">Chờ xác nhận</option>
                <option value="Đang giao" selected="@(Model.OrderData.Status == "Đang giao")">Đang giao</option>
                <option value="Hoàn thành" selected="@(Model.OrderData.Status == "Hoàn thành")">Hoàn thành</option>
                <option value="Đã hủy" selected="@(Model.OrderData.Status == "Đã hủy")">Đã hủy</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Cập nhật</button>
        </form>
    </div>
</div>

<h4>Chi tiết sản phẩm</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sách</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderData.OrderDetails)
        {
            <tr>
                <td>@item.Book.Title</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@item.Quantity</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>

<h4 class="text-end">Tổng cộng: @Model.OrderData.TotalAmount.ToString("N0") đ</h4>

<a asp-page="Index" class="btn btn-secondary">Quay lại danh sách</a>