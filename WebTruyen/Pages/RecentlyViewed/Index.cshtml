@page
@model WebTruyen.Pages.RecentlyViewed.IndexModel

@{
    ViewData["Title"] = "Lịch sử sách đã xem";
    var viewedCount = Model.ViewedBooks.Count;
}

<div class="view-history-page">

    <header class="view-history-header">

        <div>
            <span class="view-history-eyebrow">
                TỦ SÁCH CỦA BẠN
            </span>

            <h1>Lịch sử sách đã xem</h1>

            <p>
                Xem lại những cuốn sách bạn đã ghé qua gần đây.
            </p>
        </div>

        <div class="view-history-header-actions">

            <a asp-page="/Books/Index"
               class="view-history-shop-link">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5"></path>
                    <path d="m12 19-7-7 7-7"></path>
                </svg>

                Kho sách
            </a>

            @if (Model.ViewedBooks.Any())
            {
                <form method="post"
                      asp-page-handler="Clear"
                      onsubmit="return confirm('Bạn có chắc muốn xóa toàn bộ lịch sử sách đã xem?');">

                    <button type="submit"
                            class="view-history-clear">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M4 7h16"></path>
                            <path d="M9 7V4h6v3"></path>
                            <path d="m7 7 1 13h8l1-13"></path>
                            <path d="M10 11v5"></path>
                            <path d="M14 11v5"></path>
                        </svg>

                        Xóa lịch sử
                    </button>

                </form>
            }

        </div>

    </header>

    @if (TempData["Success"] != null)
    {
        <div class="view-history-alert">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <circle cx="12"
                        cy="12"
                        r="9"></circle>
                <path d="m8 12 3 3 5-6"></path>
            </svg>

            @TempData["Success"]

        </div>
    }

    @if (!Model.ViewedBooks.Any())
    {
        <section class="view-history-empty">

            <div class="view-history-empty-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M3 5h7a3 3 0 0 1 3 3v12a3 3 0 0 0-3-3H3Z"></path>
                    <path d="M21 5h-7a3 3 0 0 0-3 3v12a3 3 0 0 1 3-3h7Z"></path>
                </svg>

            </div>

            <h2>Bạn chưa xem cuốn sách nào</h2>

            <p>
                Những cuốn sách bạn mở xem sẽ được lưu lại tại đây.
            </p>

            <a asp-page="/Books/Index"
               class="view-history-empty-button">
                Khám phá kho sách
            </a>

        </section>
    }
    else
    {
        <section class="view-history-toolbar">

            <div>
                <h2>Sách đã xem gần đây</h2>

                <span>
                    @viewedCount cuốn sách
                </span>
            </div>

            <p>
                Danh sách được sắp xếp theo thời gian xem mới nhất.
            </p>

        </section>

        <section class="view-history-grid">

            @foreach (var item in Model.ViewedBooks)
            {
                <article class="view-history-card">

                    <a asp-page="/Books/Details"
                       asp-route-id="@item.BookId"
                       class="view-history-cover">

                        <img src="@(string.IsNullOrWhiteSpace(item.Book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : item.Book.ImageUrl)"
                     alt="@item.Book.Title" />

                        <span class="view-history-cover-overlay">
                            Xem sách
                        </span>

                    </a>

                    <div class="view-history-content">

                        <div class="view-history-viewed-time">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <circle cx="12"
                                        cy="12"
                                        r="9"></circle>
                                <path d="M12 7v5l3 2"></path>
                            </svg>

                            Đã xem lúc
                            @item.ViewedDate.ToString("HH:mm, dd/MM/yyyy")

                        </div>

                        <h3>
                            <a asp-page="/Books/Details"
                               asp-route-id="@item.BookId">
                                @item.Book.Title
                            </a>
                        </h3>

                        <p class="view-history-author">
                            Tác giả:
                            <strong>@item.Book.Author</strong>
                        </p>

                        <div class="view-history-bottom">

                            <span class="view-history-price">
                                @item.Book.Price.ToString("N0") đ
                            </span>

                            <a asp-page="/Books/Details"
                               asp-route-id="@item.BookId"
                               class="view-history-detail-button">

                                Xem lại

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M5 12h14"></path>
                                    <path d="m13 6 6 6-6 6"></path>
                                </svg>

                            </a>

                        </div>

                    </div>

                </article>
                }

        </section>
    }

</div>