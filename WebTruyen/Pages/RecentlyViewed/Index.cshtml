@page
@model WebTruyen.Pages.RecentlyViewed.IndexModel

@{
    ViewData["Title"] = "Sách đã xem";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Lịch sử sách đã xem</h2>
        <p class="text-muted mb-0">
            Các sách bạn đã xem gần đây.
        </p>
    </div>

    @if (Model.ViewedBooks.Any())
    {
        <form method="post"
              asp-page-handler="Clear"
              onsubmit="return confirm('Bạn có chắc muốn xóa toàn bộ lịch sử?')">

            <button type="submit"
                    class="btn btn-outline-danger">
                Xóa lịch sử
            </button>
        </form>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (!Model.ViewedBooks.Any())
{
    <div class="alert alert-info">
        Bạn chưa xem cuốn sách nào.
    </div>

    <a asp-page="/Books/Index"
       class="btn btn-primary">
        Xem danh sách sách
    </a>
}
else
{
    <div class="row">
        @foreach (var item in Model.ViewedBooks)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">

                    <a asp-page="/Books/Details"
                       asp-route-id="@item.BookId">

                        <img src="@(string.IsNullOrWhiteSpace(item.Book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : item.Book.ImageUrl)"
                     class="card-img-top"
                     alt="@item.Book.Title"
                     style="height: 260px; object-fit: cover;" />
            </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            @item.Book.Title
                        </h5>

                        <p class="text-muted mb-2">
                            @item.Book.Author
                        </p>

                        <p class="text-danger fw-bold">
                            @item.Book.Price.ToString("N0") đ
                        </p>

                        <small class="text-muted mb-3">
                            Xem lúc:
                            @item.ViewedDate.ToString("dd/MM/yyyy HH:mm")
                        </small>

                        <a asp-page="/Books/Details"
                           asp-route-id="@item.BookId"
                           class="btn btn-outline-primary mt-auto">
                            Xem lại
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}