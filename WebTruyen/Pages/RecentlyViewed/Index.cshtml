@page
@model WebTruyen.Pages.RecentlyViewed.IndexModel

@{
    ViewData["Title"] = "Lịch sử sách đã xem";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Lịch sử sách đã xem</h2>

            <p class="text-muted mb-0">
                Các sách bạn đã xem gần đây.
            </p>
        </div>

        @if (Model.ViewedBooks.Any())
        {
            <form method="post"
                  asp-page-handler="Clear"
                  onsubmit="return confirm('Bạn có chắc muốn xóa toàn bộ lịch sử?');">

                <button type="submit"
                        class="btn btn-outline-danger">
                    Xóa lịch sử
                </button>
            </form>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.ViewedBooks.Any())
    {
        <div class="alert alert-info">
            Bạn chưa xem cuốn sách nào.
        </div>

        <a asp-page="/Books/Index"
           class="btn btn-success">
            Xem danh sách sách
        </a>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="list-group list-group-flush">

                @foreach (var item in Model.ViewedBooks)
                {
                    <div class="list-group-item p-3">

                        <div class="row align-items-center">

                            <!-- Ảnh sách -->
                            <div class="col-auto">
                                <a asp-page="/Books/Details"
                                   asp-route-id="@item.BookId">

                                    <img src="@(string.IsNullOrWhiteSpace(item.Book.ImageUrl)
                                                                                         ? "/images/no-image.png"
                                                                                         : item.Book.ImageUrl)"
                                 alt="@item.Book.Title"
                                 class="rounded border"
                                 style="width: 95px;
                                                height: 130px;
                                                object-fit: cover;" />
                        </a>
                    </div>

                            <!-- Thông tin sách -->
                            <div class="col">
                                <h5 class="mb-2">
                                    <a asp-page="/Books/Details"
                                       asp-route-id="@item.BookId"
                                       class="text-dark text-decoration-none">

                                        @item.Book.Title
                                    </a>
                                </h5>

                                <p class="text-muted mb-2">
                                    Tác giả: @item.Book.Author
                                </p>

                                <p class="text-danger fw-bold mb-2">
                                    @item.Book.Price.ToString("N0") đ
                                </p>

                                <small class="text-muted">
                                    Xem lúc:
                                    @item.ViewedDate.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <!-- Nút xem lại -->
                            <div class="col-md-auto mt-3 mt-md-0">
                                <a asp-page="/Books/Details"
                                   asp-route-id="@item.BookId"
                                   class="btn btn-outline-success px-4">

                                    Xem lại
                                </a>
                            </div>

                        </div>
                    </div>
                        }

            </div>
        </div>
    }
</div>