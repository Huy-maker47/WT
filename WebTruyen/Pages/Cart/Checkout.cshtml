@page
@model WebTruyen.Pages.Cart.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
}

<h2>Thông tin đặt hàng</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label>Tên người nhận</label>
                <input asp-for="ReceiverName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Số điện thoại</label>
                <input asp-for="ReceiverPhone" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Địa chỉ giao hàng</label>
                <textarea asp-for="ShippingAddress" class="form-control" required></textarea>
            </div>
            <div class="mb-3">
                <label>Phương thức thanh toán</label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="COD">Thanh toán khi nhận hàng (COD)</option>
                    <option value="Chuyển khoản">Chuyển khoản</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Ghi chú</label>
                <textarea asp-for="Note" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-success">Đặt hàng</button>
        </form>
    </div>

    <div class="col-md-6">
        <h5>Đơn hàng của bạn</h5>
        <ul class="list-group">
            @foreach (var item in Model.CartData.CartItems)
            {
                <li class="list-group-item d-flex justify-content-between">
                    @item.Book.Title x @item.Quantity
                    <span>@((item.Quantity * item.Book.Price).ToString("N0")) đ</span>
                </li>
            }
        </ul>
        <h5 class="mt-3">Tổng: @Model.CartData.CartItems.Sum(i => i.Quantity * i.Book.Price).ToString("N0") đ</h5>
    </div>
</div>