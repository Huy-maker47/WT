<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<body>
    <div class="d-flex">
        <nav class="bg-dark text-white p-3" style="width:220px;min-height:100vh;">
            <h5>Admin Panel</h5>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link text-white" asp-page="/AdminBooks/Index">Quản lý sách</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-page="/AdminCategories/Index">Danh mục</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-page="/AdminOrders/Index">Đơn hàng</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-page="/AdminUsers/Index">Người dùng</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-page="/AdminChat/Index">Hỗ trợ khách hàng</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-page="/Index">Về trang chủ</a></li>
            </ul>
        </nav>
        <div class="p-4 flex-grow-1">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>