@model List<WebTruyen.Models.Book>

<section class="card h-100 border-0 shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Truyện mới cập nhật</h4>
    </div>

    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Chưa có sách để hiển thị.
            </div>
        }
        else
        {
            @foreach (var book in Model)
            {
                <div class="d-flex gap-3 py-3 border-bottom">
                    <a asp-page="/Books/Details"
                       asp-route-id="@book.BookId">

                        <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : book.ImageUrl)"
                                                                                 alt="@book.Title"
                                                                                 class="rounded border"
                                                                                 style="width:75px;
                                                                                                height:105px;
                                                                                                object-fit:cover;" />
                                                                        </a>

                    <div class="flex-grow-1">
                        <h6 class="mb-1">
                            <a asp-page="/Books/Details"
                               asp-route-id="@book.BookId"
                               class="text-dark text-decoration-none">
                                @book.Title
                            </a>
                        </h6>

                        <div class="small text-muted mb-1">
                            @book.Author
                        </div>

                        <div class="text-danger fw-bold">
                            @book.Price.ToString("N0") đ
                        </div>

                        <small class="text-muted">
                            Cập nhật:
                            @((book.UpdatedDate ?? book.CreatedDate)?
                                                .ToString("dd/MM/yyyy"))
                </small>
            </div>
        </div>
                }
        }
    </div>
</section>