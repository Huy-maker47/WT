@model List<WebTruyen.Models.Book>

<section class="home-spotlight-panel home-spotlight-updated">

    <header class="home-spotlight-header">

        <span class="home-spotlight-icon">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <circle cx="12"
                        cy="12"
                        r="9"></circle>
                <path d="M12 7v5l3 2"></path>
            </svg>

        </span>

        <div>
            <span>VỪA CẬP NHẬT</span>
            <h2>Sách mới nhất</h2>
        </div>

    </header>

    <div class="home-spotlight-body">

        @if (Model == null || Model.Count == 0)
        {
            <div class="home-spotlight-empty">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M3 5h7a3 3 0 0 1 3 3v12a3 3 0 0 0-3-3H3Z"></path>
                    <path d="M21 5h-7a3 3 0 0 0-3 3v12a3 3 0 0 1 3-3h7Z"></path>
                </svg>

                <strong>Chưa có sách mới</strong>

                <span>
                    Sách vừa cập nhật sẽ xuất hiện tại đây.
                </span>

            </div>
        }
        else
        {
            <div class="home-spotlight-list">

                @foreach (var book in Model)
                {
                    <article class="home-spotlight-item">

                        <span class="home-spotlight-new-badge">
                            Mới
                        </span>

                        <a asp-page="/Books/Details"
                           asp-route-id="@book.BookId"
                           class="home-spotlight-cover">

                            <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                         ? "/images/no-image.png"
                                                                         : book.ImageUrl)"
                                                                                         alt="@book.Title" />

                        </a>

                        <div class="home-spotlight-information">

                            <h3>
                                <a asp-page="/Books/Details"
                                   asp-route-id="@book.BookId">

                                    @book.Title

                                </a>
                            </h3>

                            <p>@book.Author</p>

                            <div class="home-spotlight-meta">

                                <strong>
                                    @book.Price.ToString("N0") đ
                                </strong>

                                <span>
                                    @((book.UpdatedDate ?? book.CreatedDate)?
                                                                .ToString("dd/MM/yyyy"))
                        </span>

                            </div>

                        </div>

                    </article>
                        }

            </div>
        }

    </div>

</section>