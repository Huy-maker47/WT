@model List<WebTruyen.ViewComponents.BestSellingBooksViewComponent.BestSellingBookItem>

<section class="card h-100 border-0 shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Truyện bán chạy</h4>
    </div>

    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Chưa có dữ liệu bán hàng.
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="d-flex gap-3 py-3 border-bottom">
                    <a asp-page="/Books/Details"
                       asp-route-id="@item.Book.BookId">

                        <img src="@(string.IsNullOrWhiteSpace(item.Book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : item.Book.ImageUrl)"
                     alt="@item.Book.Title"
                     class="rounded border"
                     style="width:75px;
                                    height:105px;
                                    object-fit:cover;" />
            </a>

                    <div class="flex-grow-1">
                        <h6 class="mb-1">
                            <a asp-page="/Books/Details"
                               asp-route-id="@item.Book.BookId"
                               class="text-dark text-decoration-none">
                                @item.Book.Title
                            </a>
                        </h6>

                        <div class="small text-muted mb-1">
                            @item.Book.Author
                        </div>

                        <div class="text-danger fw-bold">
                            @item.Book.Price.ToString("N0") đ
                        </div>

                        <span class="badge bg-success mt-1">
                            Đã bán @item.TotalSold
                        </span>
                    </div>
                </div>
                }
        }
    </div>
</section>