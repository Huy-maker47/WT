@using WebTruyen.Components
@using WebTruyen.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject WebTruyenContext Db

@{
    int unreadNotificationCount = 0;

    var userIdText =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (int.TryParse(userIdText, out int currentUserId))
    {
        unreadNotificationCount = await Db.Notifications
            .CountAsync(n =>
                n.UserId == currentUserId &&
                n.IsRead == false);
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WebTruyen</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/WebTruyen.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-page="/Index">
                    METruyen
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-page="/Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-page="/Books/Index">
                                Sách
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-page="/Books/BestSellers">
                                Bán chạy
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-page="/Books/NewUpdated">
                                Mới cập nhật
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Cart/Index">
                                    Giỏ hàng
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Orders/Index">
                                    Đơn hàng của tôi
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Chat/Index">
                                    Hỗ trợ trực tuyến
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/RecentlyViewed/Index">
                                    Đã xem
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Favorites/Index">
                                    Yêu thích
                                </a>
                            </li>
                            @if (User.IsInRole("Admin") ||
                                                    User.IsInRole("Staff"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-page="/AdminDashboard/Index">
                                        Trang quản trị
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Account/Profile">
                                    Profile
                                </a>
                            </li>

                            <!-- COMPONENT BLAZOR ĐƯỢC THÊM Ở ĐÂY -->
                            <li class="nav-item ms-2">
                                <component type="typeof(NotificationBell)"
                                           render-mode="ServerPrerendered"
                                           param-UnreadCount="@unreadNotificationCount" />
                                
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Account/Logout">
                                    Đăng xuất (@User.Identity.Name)
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Account/Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Account/Register">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WebTruyen
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- SCRIPT ĐỂ COMPONENT BLAZOR CÓ THỂ TƯƠNG TÁC -->
    <script src="/_framework/blazor.server.js"></script>
</body>
</html>