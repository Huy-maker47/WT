@page "{id:int}"
@model WebTruyen.Pages.AdminCategories.EditModel
@{
    ViewData["Title"] = "Sửa danh mục";
    Layout = "_AdminLayout";
}

<h2>Sửa danh mục</h2>

<form method="post">
    <input type="hidden" asp-for="CategoryInput.CategoryId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label>Tên danh mục</label>
        <input asp-for="CategoryInput.CategoryName" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
</form>