@page "{id:int}"
@model WebTruyen.Pages.AdminCategories.EditModel

@{
    ViewData["Title"] = "Sửa danh mục";
    Layout = "_AdminLayout";
}

<div class="admin-category-form-page">

    <header class="admin-category-form-header">

        <a asp-page="Index"
           class="admin-category-form-back">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m12 19-7-7 7-7"></path>
            </svg>

            Quay lại quản lý danh mục
        </a>

        <span>QUẢN TRỊ KHO SÁCH</span>

        <h1>Sửa danh mục</h1>

        <p>
            Cập nhật tên danh mục đang được sử dụng
            trong hệ thống.
        </p>

    </header>

    <form method="post"
          asp-route-id="@Model.CategoryInput.CategoryId"
          class="admin-category-form">

        <input type="hidden"
               asp-for="CategoryInput.CategoryId" />

        <div asp-validation-summary="ModelOnly"
             class="admin-category-form-validation">
        </div>

        <section class="admin-category-form-card">

            <div class="admin-category-form-card-header">

                <span class="admin-category-form-icon">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                    </svg>

                </span>

                <div>
                    <h2>Thông tin danh mục</h2>

                    <p>
                        Mã danh mục:
                        #@Model.CategoryInput.CategoryId
                    </p>
                </div>

            </div>

            <div class="admin-category-form-field">

                <label asp-for="CategoryInput.CategoryName">
                    Tên danh mục
                    <span>*</span>
                </label>

                <input asp-for="CategoryInput.CategoryName"
                       class="admin-category-form-input"
                       placeholder="Nhập tên danh mục"
                       autocomplete="off"
                       autofocus />

                <span asp-validation-for="CategoryInput.CategoryName"
                      class="admin-category-form-error">
                </span>

                <small>
                    Sách đang thuộc danh mục này sẽ tự động
                    hiển thị tên mới sau khi lưu.
                </small>

            </div>

            <div class="admin-category-form-preview">

                <span>Xem trước sau khi cập nhật</span>

                <div>
                    <i></i>

                    <strong id="categoryPreview">
                        @Model.CategoryInput.CategoryName
                    </strong>
                </div>

            </div>

            <div class="admin-category-form-warning">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="12"
                            cy="12"
                            r="9"></circle>
                    <path d="M12 11v5"></path>
                    <path d="M12 8h.01"></path>
                </svg>

                Đổi tên danh mục không xóa hoặc làm mất
                các sách đang thuộc danh mục này.

            </div>

        </section>

        <footer class="admin-category-form-actions">

            <a asp-page="Index"
               class="admin-category-form-cancel">
                Hủy thay đổi
            </a>

            <button type="submit"
                    class="admin-category-form-submit">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5 4h12l2 2v14H5Z"></path>
                    <path d="M8 4v6h8V4"></path>
                    <path d="M8 20v-6h8v6"></path>
                </svg>

                Lưu thay đổi
            </button>

        </footer>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const categoryInput =
            document.getElementById(
                "CategoryInput_CategoryName"
            );

        const categoryPreview =
            document.getElementById(
                "categoryPreview"
            );

        categoryInput.addEventListener(
            "input",
            function () {
                const value =
                    categoryInput.value.trim();

                categoryPreview.textContent =
                    value || "Tên danh mục";
            }
        );
    </script>
}