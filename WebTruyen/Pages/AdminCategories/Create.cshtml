@page
@model WebTruyen.Pages.AdminCategories.CreateModel
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "_AdminLayout";
}

<h2>Thêm danh mục</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label>Tên danh mục</label>
        <input asp-for="CategoryInput.CategoryName" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
</form>