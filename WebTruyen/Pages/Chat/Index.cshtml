@page
@model WebTruyen.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "Hỗ trợ trực tuyến";
}

<h2>Chat với Admin</h2>

<div id="chatBox" class="border rounded p-3 mb-3" style="height:400px; overflow-y:auto; background:var(--cream);">
    @foreach (var msg in Model.Messages)
    {
        <div class="mb-2 @(msg.SenderId == Model.MyUserId ? "text-end" : "text-start")">
            <span class="badge @(msg.SenderId == Model.MyUserId ? "bg-success" : "bg-secondary")">
                @msg.Content
            </span>
        </div>
    }
</div>


<form id="chatForm" class="d-flex gap-2" method="post">
    @Html.AntiForgeryToken()

    <input type="text"
           id="messageInput"
           class="form-control"
           placeholder="Nhập tin nhắn..."
           autocomplete="off" />

    <button type="submit" class="btn btn-primary">
        Gửi
    </button>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const adminId = @Model.AdminId;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (content) {
            appendMessage(content, false);
        });

        async function startConnection() {
            try {
                await connection.start();
                console.log("SignalR đã kết nối");
            } catch (error) {
                console.error("Không kết nối được SignalR:", error);
                setTimeout(startConnection, 3000);
            }
        }

        startConnection();

        document.getElementById("chatForm")
            .addEventListener("submit", async function (e) {
                e.preventDefault();

                const input = document.getElementById("messageInput");
                const content = input.value.trim();

                if (!content) {
                    return;
                }

                if (adminId <= 0) {
                    alert("Không tìm thấy tài khoản Admin.");
                    return;
                }

                const token = document.querySelector(
                    '#chatForm input[name="__RequestVerificationToken"]'
                ).value;

                try {
                    const response = await fetch(
                        window.location.pathname + "?handler=SendMessage",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": token
                            },
                            body: JSON.stringify({
                                receiverId: adminId,
                                content: content
                            })
                        }
                    );

                    if (!response.ok) {
                        const errorText = await response.text();

                        console.error(
                            "Lưu tin nhắn thất bại:",
                            response.status,
                            errorText
                        );

                        alert("Không gửi được tin nhắn.");
                        return;
                    }

                    if (
                        connection.state ===
                        signalR.HubConnectionState.Connected
                    ) {
                        await connection.invoke(
                            "SendMessage",
                            adminId,
                            content
                        );
                    }

                    appendMessage(content, true);
                    input.value = "";
                } catch (error) {
                    console.error("Lỗi gửi tin nhắn:", error);
                    alert("Có lỗi khi gửi tin nhắn.");
                }
            });

        function appendMessage(content, isMine) {
            const box = document.getElementById("chatBox");
            const div = document.createElement("div");

            div.className =
                "mb-2 " + (isMine ? "text-end" : "text-start");

            const span = document.createElement("span");

            span.className =
                "badge " +
                (isMine ? "bg-success" : "bg-secondary");

            span.textContent = content;

            div.appendChild(span);
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }
    </script>
}