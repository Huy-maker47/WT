@page
@model WebTruyen.Pages.AdminBooks.CreateModel

@{
    ViewData["Title"] = "Thêm sách mới";
    Layout = "_AdminLayout";
}

<div class="admin-book-create-page">

    <header class="admin-book-create-header">

        <div>
            <a asp-page="Index"
               class="admin-book-create-back">

                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5"></path>
                    <path d="m12 19-7-7 7-7"></path>
                </svg>

                Quay lại quản lý sách
            </a>

            <span class="admin-book-create-eyebrow">
                QUẢN TRỊ KHO SÁCH
            </span>

            <h1>Thêm sách mới</h1>

            <p>
                Điền thông tin, giá bán, tồn kho và ảnh bìa
                của cuốn sách.
            </p>
        </div>

    </header>

    <form method="post"
          enctype="multipart/form-data"
          class="admin-book-create-form">

        <div asp-validation-summary="ModelOnly"
             class="admin-book-create-validation">
        </div>

        <div class="admin-book-create-layout">

            <!-- Cột thông tin -->
            <div class="admin-book-create-main">

                <section class="admin-book-create-card">

                    <header class="admin-book-create-card-header">

                        <span class="admin-book-create-card-icon">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M3 5h7a3 3 0 0 1 3 3v12a3 3 0 0 0-3-3H3Z"></path>
                                <path d="M21 5h-7a3 3 0 0 0-3 3v12a3 3 0 0 1 3-3h7Z"></path>
                            </svg>
                        </span>

                        <div>
                            <h2>Thông tin sách</h2>
                            <p>Thông tin cơ bản hiển thị với khách hàng</p>
                        </div>

                    </header>

                    <div class="admin-book-create-grid">

                        <!-- Tên sách -->
                        <div class="admin-book-create-field full">

                            <label asp-for="BookInput.Title">
                                Tên sách
                                <span>*</span>
                            </label>

                            <input asp-for="BookInput.Title"
                                   class="admin-book-create-input"
                                   placeholder="Ví dụ: Thám Tử Lừng Danh Conan - Tập 107"
                                   autocomplete="off" />

                            <span asp-validation-for="BookInput.Title"
                                  class="admin-book-create-error">
                            </span>

                        </div>

                        <!-- Tác giả -->
                        <div class="admin-book-create-field">

                            <label asp-for="BookInput.Author">
                                Tác giả
                                <span>*</span>
                            </label>

                            <input asp-for="BookInput.Author"
                                   class="admin-book-create-input"
                                   placeholder="Nhập tên tác giả"
                                   autocomplete="off" />

                            <span asp-validation-for="BookInput.Author"
                                  class="admin-book-create-error">
                            </span>

                        </div>

                        <!-- Danh mục -->
                        <div class="admin-book-create-field">

                            <label asp-for="BookInput.CategoryId">
                                Danh mục
                                <span>*</span>
                            </label>

                            <select asp-for="BookInput.CategoryId"
                                    class="admin-book-create-input">

                                <option value="">
                                    -- Chọn danh mục --
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">
                                        @category.CategoryName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="BookInput.CategoryId"
                                  class="admin-book-create-error">
                            </span>

                        </div>

                        <!-- Mô tả -->
                        <div class="admin-book-create-field full">

                            <label asp-for="BookInput.Description">
                                Mô tả sách
                            </label>

                            <textarea asp-for="BookInput.Description"
                                      class="admin-book-create-input admin-book-create-description"
                                      rows="7"
                                      placeholder="Giới thiệu nội dung, cốt truyện hoặc điểm nổi bật của sách..."></textarea>

                            <div class="admin-book-create-help">
                                Mô tả này sẽ xuất hiện trong trang chi tiết sách.
                            </div>

                            <span asp-validation-for="BookInput.Description"
                                  class="admin-book-create-error">
                            </span>

                        </div>

                    </div>

                </section>

                <!-- Giá và tồn kho -->
                <section class="admin-book-create-card">

                    <header class="admin-book-create-card-header">

                        <span class="admin-book-create-card-icon">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M4 7h16v10H4z"></path>
                                <path d="M8 12h.01"></path>
                                <path d="M12 12h4"></path>
                            </svg>
                        </span>

                        <div>
                            <h2>Giá bán và tồn kho</h2>
                            <p>Thiết lập giá tiền và số lượng hiện có</p>
                        </div>

                    </header>

                    <div class="admin-book-create-grid">

                        <!-- Giá -->
                        <div class="admin-book-create-field">

                            <label asp-for="BookInput.Price">
                                Giá bán
                                <span>*</span>
                            </label>

                            <div class="admin-book-create-money">

                                <input asp-for="BookInput.Price"
                                       type="number"
                                       min="0"
                                       step="1"
                                       inputmode="numeric"
                                       class="admin-book-create-input"
                                       placeholder="0" />

                                <span>đ</span>

                            </div>

                            <div class="admin-book-create-help">
                                Nhập số nguyên, ví dụ: 23750.
                            </div>

                            <span asp-validation-for="BookInput.Price"
                                  class="admin-book-create-error">
                            </span>

                        </div>

                        <!-- Tồn kho -->
                        <div class="admin-book-create-field">

                            <label asp-for="BookInput.Stock">
                                Số lượng tồn kho
                                <span>*</span>
                            </label>

                            <div class="admin-book-create-stock">

                                <input asp-for="BookInput.Stock"
                                       type="number"
                                       min="0"
                                       step="1"
                                       inputmode="numeric"
                                       class="admin-book-create-input"
                                       placeholder="0" />

                                <span>cuốn</span>

                            </div>

                            <div class="admin-book-create-help">
                                Có thể nhập 0 nếu sách tạm hết hàng.
                            </div>

                            <span asp-validation-for="BookInput.Stock"
                                  class="admin-book-create-error">
                            </span>

                        </div>

                    </div>

                </section>

            </div>

            <!-- Cột ảnh -->
            <aside class="admin-book-create-sidebar">

                <section class="admin-book-create-card admin-book-image-card">

                    <header class="admin-book-create-card-header">

                        <span class="admin-book-create-card-icon">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="3"
                                      y="4"
                                      width="18"
                                      height="16"
                                      rx="2"></rect>
                                <circle cx="9"
                                        cy="10"
                                        r="2"></circle>
                                <path d="m21 15-5-5L5 20"></path>
                            </svg>
                        </span>

                        <div>
                            <h2>Ảnh bìa sách</h2>
                            <p>Ảnh đại diện hiển thị trong kho sách</p>
                        </div>

                    </header>

                    <div class="admin-book-image-preview">

                        <div id="bookImagePlaceholder"
                             class="admin-book-image-placeholder">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="4"
                                      y="3"
                                      width="16"
                                      height="18"
                                      rx="2"></rect>
                                <path d="M8 7h8"></path>
                                <path d="M8 11h6"></path>
                                <path d="M8 15h5"></path>
                            </svg>

                            <strong>Chưa chọn ảnh</strong>

                            <span>
                                Ảnh bìa sẽ hiển thị tại đây
                            </span>

                        </div>

                        <img id="bookImagePreview"
                             src=""
                             alt="Xem trước ảnh bìa"
                             hidden />

                    </div>

                    <input asp-for="ImageFile"
                           type="file"
                           id="bookImageInput"
                           accept=".jpg,.jpeg,.png,.webp"
                           hidden />

                    <label for="bookImageInput"
                           class="admin-book-image-select">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M12 16V4"></path>
                            <path d="m7 9 5-5 5 5"></path>
                            <path d="M5 20h14"></path>
                        </svg>

                        Chọn ảnh từ máy

                    </label>

                    <div id="bookImageFileName"
                         class="admin-book-image-file-name">
                        Chưa có tệp nào được chọn
                    </div>

                    <span asp-validation-for="ImageFile"
                          class="admin-book-create-error">
                    </span>

                    <div class="admin-book-image-note">

                        <strong>Gợi ý ảnh phù hợp</strong>

                        <ul>
                            <li>Định dạng JPG, PNG hoặc WebP.</li>
                            <li>Nên dùng ảnh bìa dọc.</li>
                            <li>Ảnh rõ nét, không bị méo hoặc cắt chữ.</li>
                        </ul>

                    </div>

                </section>

            </aside>

        </div>

        <!-- Nút cuối form -->
        <footer class="admin-book-create-actions">

            <a asp-page="Index"
               class="admin-book-create-cancel">
                Hủy và quay lại
            </a>

            <button type="submit"
                    class="admin-book-create-submit">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5 4h12l2 2v14H5Z"></path>
                    <path d="M8 4v6h8V4"></path>
                    <path d="M8 20v-6h8v6"></path>
                </svg>

                Lưu sách mới
            </button>

        </footer>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput =
            document.getElementById("bookImageInput");

        const imagePreview =
            document.getElementById("bookImagePreview");

        const imagePlaceholder =
            document.getElementById("bookImagePlaceholder");

        const imageFileName =
            document.getElementById("bookImageFileName");

        imageInput.addEventListener("change", function () {
            const file = imageInput.files[0];

            if (!file) {
                imagePreview.hidden = true;
                imagePreview.removeAttribute("src");

                imagePlaceholder.hidden = false;

                imageFileName.textContent =
                    "Chưa có tệp nào được chọn";

                return;
            }

            const previewUrl =
                URL.createObjectURL(file);

            imagePreview.src = previewUrl;
            imagePreview.hidden = false;
            imagePlaceholder.hidden = true;

            imageFileName.textContent =
                file.name;

            imagePreview.onload = function () {
                URL.revokeObjectURL(previewUrl);
            };
        });
    </script>
}