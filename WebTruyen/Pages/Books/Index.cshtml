<!-- Danh sách sách chính -->
@if (!Model.Books.Any())
{
    <div class="alert alert-info">
        Không tìm thấy sách nào.
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 books-page-grid">
        @foreach (var book in Model.Books)
        {
            <div class="col">
                <div class="book-card">

                    <a asp-page="Details"
                       asp-route-id="@book.BookId">

                        <img src="@(string.IsNullOrEmpty(book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : book.ImageUrl)"
                     alt="@book.Title" />
            </a>

                    <div class="card-body">
                        <div class="card-title">
                            @book.Title
                        </div>

                        <a asp-page="Index"
                           asp-route-authorName="@book.Author"
                           class="card-author d-block text-decoration-none">
                            @book.Author
                        </a>

                        <div class="card-price">
                            @book.Price.ToString("N0") đ
                        </div>

                        <a asp-page="Details"
                           asp-route-id="@book.BookId"
                           class="btn btn-outline-primary btn-sm mt-2 w-100">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
                }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="books-pagination"
             aria-label="Phân trang danh sách sách">

            <!-- Trang trước -->
            @if (Model.PageNumber > 1)
            {
                <a asp-page="/Books/Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-authorName="@Model.AuthorName"
                   asp-route-sort="@Model.Sort"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   class="books-pagination-button"
                   aria-label="Trang trước">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                </a>
            }
            else
            {
                <span class="books-pagination-button disabled">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                </span>
            }

            <!-- Các số trang -->
            @for (
                int pageNumber = 1;
                pageNumber <= Model.TotalPages;
                pageNumber++
                )
            {
                if (pageNumber == Model.PageNumber)
                {
                    <span class="books-pagination-number active">
                        @pageNumber
                    </span>
                }
                else
                {
                    <a asp-page="/Books/Index"
                       asp-route-pageNumber="@pageNumber"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-authorName="@Model.AuthorName"
                       asp-route-sort="@Model.Sort"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       class="books-pagination-number">

                        @pageNumber
                    </a>
                }
            }

            <!-- Trang sau -->
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-page="/Books/Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-authorName="@Model.AuthorName"
                   asp-route-sort="@Model.Sort"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   class="books-pagination-button"
                   aria-label="Trang tiếp theo">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </a>
            }
            else
            {
                <span class="books-pagination-button disabled">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </span>
            }

        </nav>
    }
}