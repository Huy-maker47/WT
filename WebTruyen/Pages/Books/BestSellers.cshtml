@page
@model WebTruyen.Pages.Books.BestSellersModel

@{
    ViewData["Title"] = "Sách bán chạy";
}

<div class="mb-4">
    <h2>Sách bán chạy</h2>

    <p class="text-muted">
        Những cuốn sách được khách hàng đặt mua nhiều nhất.
    </p>
</div>

@if (!Model.BestSellingBooks.Any())
{
    <div class="alert alert-info">
        Chưa có dữ liệu bán hàng để thống kê.
    </div>

    <a asp-page="/Books/Index"
       class="btn btn-primary">
        Xem danh sách sách
    </a>
}
else
{
    <div class="row">
        @{
            var rank = 1;
        }

        @foreach (var item in Model.BestSellingBooks)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm position-relative">

                    <span class="badge bg-danger position-absolute top-0 start-0 m-2"
                          style="z-index: 2;">
                        Top @rank
                    </span>

                    <a asp-page="/Books/Details"
                       asp-route-id="@item.Book.BookId">

                        <img src="@(string.IsNullOrWhiteSpace(item.Book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : item.Book.ImageUrl)"
                     class="card-img-top"
                     alt="@item.Book.Title"
                     style="height: 280px; object-fit: cover;" />
            </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            @item.Book.Title
                        </h5>

                        <p class="text-muted mb-2">
                            @item.Book.Author
                        </p>

                        <p class="text-danger fw-bold mb-2">
                            @item.Book.Price.ToString("N0") đ
                        </p>

                        <p class="mb-3">
                            <span class="badge bg-success">
                                Đã bán @item.SoldQuantity cuốn
                            </span>
                        </p>

                        <a asp-page="/Books/Details"
                           asp-route-id="@item.Book.BookId"
                           class="btn btn-outline-primary mt-auto">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>

        rank++;
        }
    </div>
}