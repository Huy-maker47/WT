@page
@model WebTruyen.Pages.Books.NewUpdatedModel

@{
    ViewData["Title"] = "Sách mới cập nhật";
}

<div class="mb-4">
    <h2>Sách mới cập nhật</h2>

    <p class="text-muted">
        Những cuốn sách vừa được thêm hoặc chỉnh sửa gần đây.
    </p>
</div>

@if (!Model.Books.Any())
{
    <div class="alert alert-info">
        Chưa có sách để hiển thị.
    </div>
}
else
{
    <div class="row">
        @foreach (var book in Model.Books)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">

                    <a asp-page="/Books/Details"
                       asp-route-id="@book.BookId">

                        <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                 ? "/images/no-image.png"
                                                                 : book.ImageUrl)"
                     class="card-img-top"
                     alt="@book.Title"
                     style="height: 280px; object-fit: cover;" />
            </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            @book.Title
                        </h5>

                        <p class="text-muted mb-2">
                            @book.Author
                        </p>

                        <p class="text-danger fw-bold mb-2">
                            @book.Price.ToString("N0") đ
                        </p>

                @if (book.Category != null)
                        {
                            <small class="text-muted">
                                Danh mục: @book.Category.CategoryName
                            </small>
                        }

                    <small class="text-muted mb-3">
                        Cập nhật:
                        @((book.UpdatedDate ?? book.CreatedDate)?
                                            .ToString("dd/MM/yyyy HH:mm"))
                </small>

                        <a asp-page="/Books/Details"
                           asp-route-id="@book.BookId"
                           class="btn btn-outline-primary mt-auto">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}